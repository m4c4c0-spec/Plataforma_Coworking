# Copia este archivo a .env y completa los valores localmente.
# .env está excluido de Git. Django lo lee con python-decouple.

# Genera una clave con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='REEMPLAZA_CON_UNA_CLAVE_SECRETA'

# Opcional: ruta del administrador de Django (por defecto gestion-interna).
# DJANGO_ADMIN_URL_PATH=gestion-interna

# Base de datos principal MySQL/MariaDB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=plataforma_coworking_local
MYSQL_USER=coworking_local
MYSQL_PASSWORD='REEMPLAZA_CON_TU_CONTRASENA'
