# Copia este archivo a .env y completa los valores localmente.
# .env está excluido de Git. Django lo lee con python-decouple.

# Genera una clave con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='REEMPLAZA_CON_UNA_CLAVE_SECRETA'

# Mantener en False para ver la página 404 personalizada y no exponer detalles del servidor.
DEBUG=False

# Base de datos principal MySQL/MariaDB.
# En Linux/macOS el sistema ya define USER y decouple le da prioridad sobre este
# archivo: ejecuta los comandos con "env -u USER" (ver README).
NAME=plataforma_coworking_local
HOST=127.0.0.1
PORT=3306
USER=coworking_local
PASSWORD='REEMPLAZA_CON_TU_CONTRASENA'

# Opcional: puerto de phpMyAdmin en compose.yaml (por defecto 8081).
# PHPMYADMIN_PORT=8081
