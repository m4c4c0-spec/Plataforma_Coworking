# Copia este archivo a .env.mysql y completa la contraseña localmente.
# .env.mysql está excluido de Git. Django no lo lee automáticamente.
DJANGO_MYSQL_ENABLED=1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=plataforma_coworking_local
MYSQL_USER=coworking_local
MYSQL_PASSWORD='REEMPLAZA_CON_TU_CONTRASENA'
